[run]
source = .
omit =
    */tests/*
    */migrations/*
    */venv/*
    */.venv/*
    */__pycache__/*
    setup.py
    */node_modules/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
