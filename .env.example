# LinkVision Environment Configuration
# Скопируйте этот файл в .env и настройте переменные

# =============================================================================
# БЕЗОПАСНОСТЬ (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
# =============================================================================

# Секретный ключ для сессий и CSRF
# Сгенерируйте новый: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-me-in-production

# =============================================================================
# БАЗА ДАННЫХ
# =============================================================================

# PostgreSQL (рекомендуется для production)
# DATABASE_URL=postgresql://user:password@localhost:5432/linkvision

# SQLite (по умолчанию, для разработки)
# DATABASE_URL=sqlite:///./linkvision.db

# =============================================================================
# РЕЖИМ РАБОТЫ
# =============================================================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Режим отладки Flask (False для production!)
FLASK_DEBUG=False

# =============================================================================
# БЕЗОПАСНОСТЬ СЕССИЙ
# =============================================================================

# Использовать HTTPS для cookies (True для production)
SESSION_COOKIE_SECURE=False

# Приложение работает за прокси (nginx, etc.)
BEHIND_PROXY=False

# =============================================================================
# SOCKET.IO
# =============================================================================

# Heartbeat: «тихо» упавший сервер клиент замечает не позже ping_interval +
# ping_timeout секунд. proxy_read_timeout в nginx для /socket.io/ должен быть
# больше этой суммы (по умолчанию 25 + 30 = 55 с, рекомендуется >= 120s).
# SOCKETIO_PING_INTERVAL=25
# SOCKETIO_PING_TIMEOUT=30

# Допустимые Origin для WebSocket. Пусто = только тот же origin, что и страница.
# Список через запятую или "*" (небезопасно при авторизации по cookie).
# SOCKETIO_CORS_ORIGINS=https://linkvision.example.com

# =============================================================================
# REDIS (для rate limiting в production)
# =============================================================================

# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SENTRY (мониторинг ошибок)
# =============================================================================

# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
